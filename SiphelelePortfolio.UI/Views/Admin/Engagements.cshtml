@model IEnumerable<SiphelelePortfolio.Data.Models.Domain.Engagement>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Engagements"; }

<div class="page-header"><h1>Engagements</h1></div>

<div class="table-wrap">
  <table>
    <thead>
      <tr><th>Date</th><th>Event</th><th>Target</th><th>IP</th></tr>
    </thead>
    <tbody>
      @if (!Model.Any())
      {
        <tr><td colspan="4" style="text-align:center;padding:30px;color:#888;">No engagements recorded yet.</td></tr>
      }
      @foreach (var e in Model)
      {
        <tr>
          <td>@e.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
          <td><span class="status-badge">@e.EventType</span></td>
          <td>@(e.TargetLabel ?? "—")</td>
          <td>@(e.IpAddress ?? "—")</td>
        </tr>
      }
    </tbody>
  </table>
</div>