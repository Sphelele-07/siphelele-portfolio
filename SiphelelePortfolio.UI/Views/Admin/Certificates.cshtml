@model IEnumerable<SiphelelePortfolio.Data.Models.Domain.Certificate>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Certificates"; }

<div class="page-header" style="display:flex;justify-content:space-between;align-items:center;">
  <h1>Certificates</h1>
  <a asp-action="CertificateCreate" class="btn-gold">+ Add Certificate</a>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr><th>Title</th><th>Organization</th><th>Date</th><th>Actions</th></tr>
    </thead>
    <tbody>
      @if (!Model.Any())
      {
        <tr><td colspan="4" style="text-align:center;padding:30px;color:#888;">No certificates yet. Click "Add Certificate" to create one.</td></tr>
      }
      @foreach (var c in Model)
      {
        <tr>
          <td><strong>@c.Title</strong></td>
          <td>@c.IssuingOrganization</td>
          <td>@c.IssueDate.ToString("dd MMM yyyy")</td>
          <td>
            <a asp-action="CertificateEdit" asp-route-id="@c.CertificateId" class="btn-action edit">Edit</a>
            <form asp-action="CertificateDelete" asp-route-id="@c.CertificateId" method="post"
                  style="display:inline;" data-confirm="Delete this certificate?">
              @Html.AntiForgeryToken()
              <button type="submit" class="btn-action approve" style="background:#f8d7da;color:#721c24;">Delete</button>
            </form>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>