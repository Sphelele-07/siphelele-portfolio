            <div class="system-tile-header">
                <h3>Bingo Royale Goldrush</h3>
                <span class="system-tile-role">Customer Service & Systems Support</span>
            </div>
            <ul class="system-list">
                <li>
                    <strong>CMS</strong>
                    <span>Content management</span>
                </li>
                <li>
                    <strong>Float</strong>
                    <span>Issuing and receiving float</span>
                </li>
                <li>
                    <strong>Vault</strong>
                    <span>Employee management</span>
                </li>
                <li>
                    <strong>Isitaki</strong>
                    <span>Credit card transaction operations, transaction history</span>
                </li>
                <li>
                    <strong>DRGT</strong>
                    <span>Punter records, Bingo machine maintenance, employee shift records</span>
                </li>
                <li>
                    <strong>GAAP</strong>
                    <span>Inventory management</span>
                </li>
                <li>
                    <strong>Bingo Slots IGT</strong>
                    <span>Technical support & component maintenance</span>
                </li>
                <li>
                    <strong>Operational Shift Roster</strong>
                    <span>Maintenance and updates</span>
                </li>
                <li>
                    <strong>Data Capturing Systems</strong>
                    <span>Entry, validation, and accuracy checks</span>
                </li>
            </ul>
        </div>

        <!-- TENACITY TILE -->
        <div class="system-tile">
            <div class="system-tile-header">
                <h3>Tenacity Financial Services</h3>
                <span class="system-tile-role">Collections Consultant</span>
            </div>
            <ul class="system-list">
                <li>
                    <strong>Presence</strong>
                    <span>Employee call records</span>
                </li>
                <li>
                    <strong>Einstein</strong>
                    <span>Customer database and information retrieval</span>
                </li>
                <li>
                    <strong>Inovo</strong>
                    <span>Dialer operations</span>
                </li>
                <li>
                    <strong>Alchemy</strong>
                    <span>Debit order records</span>
                </li>
            </ul>
        </div>

    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     5. TECHNICAL SKILLS
     ═══════════════════════════════════════════════════════════════ -->
<section class="section">
    <div class="section-title">
        <h2>Technical Skills</h2>
        <p>The stack I build with every day.</p>
    </div>
    <div class="skills-grid">
        @foreach (var group in Model.TechnicalSkills)
        {
            <div class="skill-group">
                <h4>@group.Category</h4>
                <div class="tags">
                    @foreach (var item in group.Items)
                    {
                        <span class="tag">@item</span>
                    }
                </div>
            </div>
        }
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     6. TSIBA COURSEWORK
     ═══════════════════════════════════════════════════════════════ -->
<section class="section">
    <div class="section-title">
        <h2>Formal Training — TSIBA Business School</h2>
        <p>Software Testing & Systems Analysis Work Readiness Programme.</p>
    </div>
    <div class="coursework-grid">
        @foreach (var module in Model.Coursework)
        {
            <div class="course-card">
                <span class="course-code">@module.Code</span>
                <h4>@module.Title</h4>
                <p>@module.Covered</p>
            </div>
        }
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     7. CERTIFICATIONS
     ═══════════════════════════════════════════════════════════════ -->
<section class="section">
    <div class="section-title">
        <h2>Certifications</h2>
        <p>Industry-recognised qualifications.</p>
    </div>
    <div class="projects-grid">
        @foreach (var cert in Model.Certificates)
        {
            <div class="glass-card" style="padding:24px;">
                <h3 style="color:var(--powder-blue);font-size:18px;font-family:'Segoe UI',sans-serif;">@cert.Title</h3>
                <p style="color:var(--text-secondary);font-size:13px;">@cert.IssuingOrganization</p>
                <p style="color:var(--text-muted);font-size:12px;">Issued: @cert.IssueDate.ToString("dd MMM yyyy")</p>
                @if (!string.IsNullOrEmpty(cert.CertificateUrl))
                {
                    <a href="@cert.CertificateUrl" class="btn-outline btn-sm" style="margin-top:12px;">View Certificate</a>
                }
            </div>
        }
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     8. PROJECTS
     ═══════════════════════════════════════════════════════════════ -->
<section id="projects" class="section">
    <div class="section-title">
        <h2>My Projects</h2>
        <p>A showcase of my recent work.</p>
    </div>
    <div class="projects-grid">
        @foreach (var p in Model.Projects)
        {
            // Force Mouzie to be Coming Soon and use the new image
            var isMouzie = p.Title.Contains("Mouzie", StringComparison.OrdinalIgnoreCase);
            var isMerrydale = p.Title.Contains("Merrydale", StringComparison.OrdinalIgnoreCase);

            // If it's Mouzie, turn off Demo and Live links. Otherwise, check the DB.
            var hasDemo = !isMouzie && !string.IsNullOrWhiteSpace(p.DemoVideoUrl) && !p.DemoVideoUrl.Contains("YOUR_", StringComparison.OrdinalIgnoreCase);
            var hasLiveUrl = !isMouzie && !string.IsNullOrWhiteSpace(p.LiveUrl);

            // Swap the image for Mouzie
            var imageSrc = isMouzie ? "/images/mouzie.png" : p.ImagePath;

            <div class="project-card">
                <img src="@imageSrc" alt="@p.Title" class="project-img"
                     onerror="this.src='https://via.placeholder.com/400x200?text=Project'">
                <div class="project-info">
                    <h3>@p.Title</h3>
                    <h4>@p.Type</h4>
                    <p>@p.Solution</p>
                    <div class="project-tags">
                        @foreach (var tag in p.Tags.Split(','))
                        {
                            <span>@tag.Trim()</span>
                        }
                    </div>
                    <div class="project-actions">
                        <!-- Demo Video Button -->
                        @if (hasDemo)
                        {
                            <a href="@p.DemoVideoUrl" class="btn-outline btn-sm"
                               onclick="logEngagement('ClickDemoVideo', @p.ProjectId, '@p.Title')">🎥 Live Demo</a>
                        }
                        else
                        {
                            <span class="btn-outline btn-sm disabled" style="opacity: 0.5; cursor: not-allowed; pointer-events: none;">🎥 Coming Soon</span>
                        }

                        <!-- Test Yourself Button -->
                        @if (hasLiveUrl)
                        {
                            <a href="@p.LiveUrl" class="btn-gold btn-sm"
                               onclick="logEngagement('ClickTestYourself', @p.ProjectId, '@p.Title')">🧪 Test Yourself</a>
                        }
                        else
                        {
                            <span class="btn-gold btn-sm disabled" style="opacity: 0.5; cursor: not-allowed; pointer-events: none;">🧪 Coming Soon</span>
                        }

                        <!-- Requirements Button -->
                        @if (isMerrydale)
                        {
                            <a href="/Home/DownloadMerrydaleRequirements" class="btn-outline btn-sm">📄 Requirements</a>
                        }
                        else
                        {
                            <a href="/api/project/download-requirements/@p.ProjectId" class="btn-outline btn-sm">📄 Requirements</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     9. LET'S COLLABORATE CTA
     ═══════════════════════════════════════════════════════════════ -->
<section class="section section-cta">
    <div class="glass-card text-center">
        <h2>Let's Build Something Great Together</h2>
        <p style="margin-bottom: 24px;">Have a project in mind? Let's talk.</p>
        <a asp-controller="Collaboration" asp-action="Index" class="btn-gold btn-lg">Let's Collaborate</a>
    </div>
</section>