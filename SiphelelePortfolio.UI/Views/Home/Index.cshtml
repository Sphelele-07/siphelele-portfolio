@model SiphelelePortfolio.Data.Models.ViewModels.HomeVM
@{
    ViewData["Title"] = "Siphelele Ndzundzu | Full-Stack Developer";
}

<!-- ═══════════════════════════════════════════════════════════════
     1. HERO
     ═══════════════════════════════════════════════════════════════ -->
<section class="hero">
    <div class="hero-text">
        <h1>Hello, I'm <br><span>Siphelele Ndzundzu</span></h1>
        <h2>Full-Stack Developer</h2>
        <p>I build modern, secure and scalable web applications using .NET, C# and modern technologies.</p>
        <div class="hero-buttons">
            <a href="#projects" class="btn-gold">View My Projects</a>
            <a asp-controller="Collaboration" asp-action="Index" class="btn-outline">Let's Collaborate</a>
        </div>
    </div>
    <div class="hero-image">
        <img src="~/images/Sphelele_Corporate.png" alt="Siphelele Ndzundzu" />
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     2. ABOUT
     ═══════════════════════════════════════════════════════════════ -->
<section class="section">
    <div class="glass-card">
        <div class="about-grid">
            <div class="about-img">
                <img src="~/images/Sphelele_Grad.png" alt="Siphelele Graduation" />
            </div>
            <div class="about-text">
                <h2>About Me</h2>
                <p>
                    I'm a <strong>Software Development Graduate</strong> based in Cape Town with hands-on experience
                    across technical support, customer operations, and business systems. My approach to building
                    software starts with understanding the problem — not the code. I design solutions that are
                    <strong>practical, secure, and built for the people who use them</strong>.
                </p>
                <p>
                    I work primarily with <strong>C#, ASP.NET Core MVC, SQL Server, and Dapper</strong>, and I
                    complement my development skills with formal training in <strong>
                    Software Testing & Systems
                    Analysis
                </strong>. That means I don't just ship features — I validate them, document them, and
                make sure they hold up under real-world use.
                </p>
                <p>
                    I'm currently building a growing portfolio of production-style applications, including
                    <strong>Mouzie Guest House</strong> (a full-stack booking system with automated invoicing) and
                    <strong>Merrydale Pharmacy</strong> (a pharmacy management platform with real-time stock
                    control). Every project is deployed, tested, and documented — not just a GitHub commit.
                </p>

                <h3 style="margin-top: 24px; font-size: 18px; color: var(--powder-blue); font-family: 'Segoe UI', sans-serif;">
                    What I bring
                </h3>
                <ul class="about-list">
                    <li>🎓 <strong>Diploma in Software Development</strong> — Nelson Mandela University</li>
                    <li>🎓 <strong>TSIBA Business School</strong> — Software Testing & Systems Analysis Work Readiness</li>
                    <li>💻 <strong>2 production-grade projects</strong> deployed and documented</li>
                    <li>🔒 Focus on secure, tested, and maintainable code</li>
                    <li>📍 Based in Cape Town, South Africa</li>
                    <li>💼 <strong>Open to Work</strong> — Junior Dev, QA, Technical Support, Systems Admin</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     3. WORK EXPERIENCE
     ═══════════════════════════════════════════════════════════════ -->
<section class="section">
    <div class="section-title">
        <h2>Work Experience</h2>
        <p>Where I've built my professional foundation.</p>
    </div>
    <div class="experience-grid">
        <div class="experience-card">
            <div class="experience-header">
                <div>
                    <h3>Customer Service &amp; Systems Support Assistant</h3>
                    <span class="experience-company">Bingo Royale Goldrush</span>
                </div>
                <span class="experience-period"></span>
            </div>
            <p>Hardware/software troubleshooting, incident management, ticketing systems, and escalation handling. Maintained and supported 9 business-critical systems across the operation.</p>
            <div class="experience-systems">
                <strong>Systems used:</strong> CMS, Float, Vault, Isitaki, DRGT, GAAP, Bingo Slots IGT, Operational Shift Roster System, Data Capturing Systems
            </div>
        </div>

        <div class="experience-card">
            <div class="experience-header">
                <div>
                    <h3>Collections Agent</h3>
                    <span class="experience-company">Tenacity Financial Services</span>
                </div>
                <span class="experience-period"></span>
            </div>
            <p>Account management, billing dispute resolution, regulatory compliance, and accurate record keeping. Operated 4 financial systems daily.</p>
            <div class="experience-systems">
                <strong>Systems used:</strong> Presence, Einstein, Inovo, Alchemy
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     4. SYSTEMS I'VE WORKED WITH — Two Tiles
     ═══════════════════════════════════════════════════════════════ -->
