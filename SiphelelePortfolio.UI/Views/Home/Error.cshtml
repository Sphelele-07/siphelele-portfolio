@{
    ViewData["Title"] = "Error";
}

<section class="section" style="min-height:70vh;display:flex;align-items:center;">
  <div class="glass-card text-center" style="max-width:500px;margin:0 auto;">
    <h1 style="color:#ff6b6b;font-size:72px;margin-bottom:10px;">Oops</h1>
    <h2 style="color:var(--gold);margin-bottom:20px;">Something went wrong</h2>
    <p style="color:var(--muted);margin-bottom:30px;">
      We couldn't complete your request. Please try again.
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn-gold">Back to Home</a>
  </div>
</section>