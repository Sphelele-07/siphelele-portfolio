<div id="confirmModal" class="modal-overlay hidden" role="dialog" aria-modal="true">
  <div class="modal">
    <h3 id="confirmTitle">Are you sure?</h3>
    <p id="confirmMessage">This action cannot be undone.</p>
    <div class="modal-actions">
      <button id="confirmCancelBtn" class="btn-outline" type="button">Cancel</button>
      <button id="confirmOkBtn" class="btn-gold" type="button">Confirm</button>
    </div>
  </div>
</div>